@model TicketGo.Application.DTOs.DashboardStatisticsDto

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Dashboard - Thống kê";
}

<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <h1 class="text-3xl font-bold text-gray-900">Dashboard</h1>
            <nav class="flex" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-2 text-sm text-gray-600">
                    <li class="inline-flex items-center">
                        <a href="javascript:void(0);" class="hover:text-gray-800">Admin</a>
                    </li>
                    <li class="inline-flex items-center">
                        <span class="mx-2">/</span>
                        <span class="font-medium text-gray-800">Dashboard</span>
                    </li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow p-6 flex items-center space-x-4">
            <div class="flex-shrink-0 w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center">
                <i class="fas fa-receipt text-white text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Tổng đơn hàng</p>
                <h3 class="text-2xl font-bold text-gray-900">@Model.TotalOrders.ToString("N0")</h3>
                <p class="text-sm text-green-600">Hôm nay: @Model.TodayOrders</p>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow p-6 flex items-center space-x-4">
            <div class="flex-shrink-0 w-12 h-12 bg-green-600 rounded-lg flex items-center justify-center">
                <i class="fas fa-dollar-sign text-white text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Tổng doanh thu</p>
                <h3 class="text-2xl font-bold text-gray-900">@Model.TotalRevenue.ToString("N0") VND</h3>
                <p class="text-sm text-green-600">Hôm nay: @Model.TodayRevenue.ToString("N0") VND</p>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow p-6 flex items-center space-x-4">
            <div class="flex-shrink-0 w-12 h-12 bg-blue-400 rounded-lg flex items-center justify-center">
                <i class="fas fa-users text-white text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Khách hàng</p>
                <h3 class="text-2xl font-bold text-gray-900">@Model.TotalCustomers.ToString("N0")</h3>
                <p class="text-sm text-blue-500">Tổng số khách hàng đã đăng ký</p>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow p-6 flex items-center space-x-4">
            <div class="flex-shrink-0 w-12 h-12 bg-yellow-600 rounded-lg flex items-center justify-center">
                <i class="fas fa-train text-white text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Chuyến xe</p>
                <h3 class="text-2xl font-bold text-gray-900">@Model.TotalTrains.ToString("N0")</h3>
                <p class="text-sm text-yellow-600">Tuyến đường: @Model.TotalRoutes</p>
            </div>
        </div>
    </div>

    <!-- Charts and Period Statistics -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <!-- Period Statistics -->
        <div class="bg-white rounded-xl shadow-sm p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Thống kê theo thời gian</h2>
            <div class="grid grid-cols-2 gap-4">
                <div class="text-center p-4 bg-gray-50 rounded-lg">
                    <p class="text-sm text-gray-600 mb-1">Tuần này</p>
                    <h3 class="text-xl font-bold text-gray-900">@Model.WeekRevenue.ToString("N0") VND</h3>
                    <p class="text-sm text-gray-600">@Model.WeekOrders đơn hàng</p>
                </div>
                <div class="text-center p-4 bg-gray-50 rounded-lg">
                    <p class="text-sm text-gray-600 mb-1">Tháng này</p>
                    <h3 class="text-xl font-bold text-gray-900">@Model.MonthRevenue.ToString("N0") VND</h3>
                    <p class="text-sm text-gray-600">@Model.MonthOrders đơn hàng</p>
                </div>
            </div>
        </div>
        <!-- Monthly Revenue Chart -->
        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Doanh thu theo tháng (@DateTime.Now.Year)</h2>
            <div class="relative h-64">
                <canvas id="monthlyRevenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Daily Revenue and Top Routes/Trains -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <!-- Daily Revenue Chart -->
        <div class="bg-white rounded-xl shadow-sm p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Doanh thu 30 ngày gần đây</h2>
            <div class="relative h-64">
                <canvas id="dailyRevenueChart"></canvas>
            </div>
        </div>
        <!-- Top Routes and Trains (Tabs) -->
        <div class="bg-white rounded-xl shadow-sm p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Top 5 tuyến đường & chuyến xe</h2>
            <div class="flex mb-4 border-b border-gray-200">
                <button id="tab-routes" class="px-4 py-2 text-sm font-medium text-gray-700 border-b-2 border-blue-500 focus:outline-none">Tuyến đường</button>
                <button id="tab-trains" class="px-4 py-2 text-sm font-medium text-gray-700 hover:border-b-2 hover:border-blue-500 focus:outline-none">Chuyến xe</button>
            </div>
            <div id="routes-table" class="overflow-x-auto">
                <table class="w-full text-sm text-left text-gray-800">
                    <thead class="text-xs uppercase bg-gray-100">
                        <tr>
                            <th class="px-4 py-3 font-semibold">Tuyến đường</th>
                            <th class="px-4 py-3 font-semibold">Số đơn hàng</th>
                            <th class="px-4 py-3 font-semibold">Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var route in Model.TopRoutes)
                        {
                            <tr class="border-b hover:bg-gray-50">
                                <td class="px-4 py-3">@route.RouteName</td>
                                <td class="px-4 py-3">@route.TotalOrders</td>
                                <td class="px-4 py-3">@route.TotalRevenue.ToString("N0") VND</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="trains-table" class="overflow-x-auto hidden">
                <table class="w-full text-sm text-left text-gray-800">
                    <thead class="text-xs uppercase bg-gray-100">
                        <tr>
                            <th class="px-4 py-3 font-semibold">Tên chuyến xe</th>
                            <th class="px-4 py-3 font-semibold">ягионг đường</th>
                            <th class="px-4 py-3 font-semibold">Số đơn hàng</th>
                            <th class="px-4 py-3 font-semibold">Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var train in Model.TopTrains)
                        {
                            <tr class="border-b hover:bg-gray-50">
                                <td class="px-4 py-3">@train.TrainName</td>
                                <td class="px-4 py-3">@train.RouteName</td>
                                <td class="px-4 py-3">@train.TotalOrders</td>
                                <td class="px-4 py-3">@train.TotalRevenue.ToString("N0") VND</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Monthly Revenue Chart
        const monthlyData = @Html.Raw(Json.Serialize(Model.MonthlyRevenue));
        const monthlyCtx = document.getElementById('monthlyRevenueChart').getContext('2d');
        new Chart(monthlyCtx, {
            type: 'line',
            data: {
                labels: ['Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6', 
                        'Tháng 7', 'Tháng 8', 'Tháng 9', 'Tháng 10', 'Tháng 11', 'Tháng 12'],
                datasets: [{
                    label: 'Doanh thu (VND)',
                    data: monthlyData.map(d => d.revenue),
                    borderColor: 'rgb(75, 192, 192)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    tension: 0.1
                }, {
                    label: 'Số đơn hàng',
                    data: monthlyData.map(d => d.orders),
                    borderColor: 'rgb(255, 99, 132)',
                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                    yAxisID: 'y1',
                    tension: 0.1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: {
                            display: true,
                            text: 'Doanh thu (VND)',
                            font: { size: 12 }
                        },
                        ticks: { font: { size: 10 } }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        title: {
                            display: true,
                            text: 'Số đơn hàng',
                            font: { size: 12 }
                        },
                        grid: { drawOnChartArea: false },
                        ticks: { font: { size: 10 } }
                    },
                    x: {
                        title: { display: true, text: 'Tháng', font: { size: 12 } },
                        ticks: { font: { size: 10 } }
                    }
                },
                plugins: {
                    legend: { labels: { font: { size: 10 } } }
                }
            }
        });

        // Daily Revenue Chart
        const dailyData = @Html.Raw(Json.Serialize(Model.RecentDailyRevenue));
        const dailyCtx = document.getElementById('dailyRevenueChart').getContext('2d');
        new Chart(dailyCtx, {
            type: 'bar',
            data: {
                labels: dailyData.map(d => new Date(d.date).toLocaleDateString('vi-VN')),
                datasets: [{
                    label: 'Doanh thu (VND)',
                    data: dailyData.map(d => d.revenue),
                    backgroundColor: 'rgba(54, 162, 235, 0.5)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Doanh thu (VND)',
                            font: { size: 12 }
                        },
                        ticks: { font: { size: 10 } }
                    },
                    x: {
                        title: { display: true, text: 'Ngày', font: { size: 12 } },
                        ticks: { font: { size: 10 }, maxRotation: 45, minRotation: 45 }
                    }
                },
                plugins: {
                    legend: { labels: { font: { size: 10 } } }
                }
            }
        });

        // Tab Switching Logic
        document.getElementById('tab-routes').addEventListener('click', () => {
            document.getElementById('routes-table').classList.remove('hidden');
            document.getElementById('trains-table').classList.add('hidden');
            document.getElementById('tab-routes').classList.add('border-b-2', 'border-blue-500');
            document.getElementById('tab-trains').classList.remove('border-b-2', 'border-blue-500');
        });

        document.getElementById('tab-trains').addEventListener('click', () => {
            document.getElementById('trains-table').classList.remove('hidden');
            document.getElementById('routes-table').classList.add('hidden');
            document.getElementById('tab-trains').classList.add('border-b-2', 'border-blue-500');
            document.getElementById('tab-routes').classList.remove('border-b-2', 'border-blue-500');
        });
    </script>
}